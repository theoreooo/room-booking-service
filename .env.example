# Server
HTTP_ADDR=0.0.0.0:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s

# Logging
LOG_LEVEL=debug

# Database
# Keep these values aligned with docker-compose defaults for local development.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=booking
DB_PASSWORD=booking
DB_NAME=booking
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONNECT_TIMEOUT=10s

# Auth
JWT_SECRET=supersecret
JWT_ACCESS_TOKEN_TTL=24h
DUMMY_ADMIN_UUID=00000000-0000-0000-0000-000000000001
DUMMY_USER_UUID=00000000-0000-0000-0000-000000000002

# Conference mock
CONFERENCE_BASE_URL=https://conference.mock.local
CONFERENCE_MOCK_FAIL_CREATE=false
CONFERENCE_MOCK_FAIL_DELETE=false

# Worker
WORKER_SLOT_GENERATION_DAYS=7
WORKER_INTERVAL=1h
